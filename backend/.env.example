# ==========================================
# CONFIGURATION GÉNÉRALE DU SERVEUR
# ==========================================
PORT=8080
NODE_ENV=production
HOST=0.0.0.0

# ==========================================
# BASE DE DONNÉES MYSQL
# ==========================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=project_manager
DB_LOGGING=false
DB_RETRY_ATTEMPTS=5
DB_RETRY_DELAY_MS=2000

# ==========================================
# AUTHENTIFICATION & SÉCURITÉ
# ==========================================
JWT_SECRET=changez_ce_secret_en_production_avec_au_moins_32_caracteres_securises
JWT_EXPIRES_IN=30d

# ==========================================
# CORS & FRONTEND
# ==========================================
CORS_ORIGIN=https://votre-domaine.com
CLIENT_URL=https://votre-domaine.com

# ==========================================
# COMPTE ADMINISTRATEUR INITIAL
# ==========================================
ADMIN_NAME=Administrateur Principal
ADMIN_EMAIL=admin@votre-domaine.com
ADMIN_PASSWORD=DefinirUnMotDePasseFort123!

# ==========================================
# SYSTÈME DE LOGS ET FICHIERS
# ==========================================
LOG_LEVEL=info
FILE_LOGGING=true
UPLOAD_DIR=uploads

# ==========================================
# LIMITATION DE DÉBIT (RATE LIMITING)
# ==========================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL_WINDOW_MS=900000
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_SENSITIVE_WINDOW_MS=900000
RATE_LIMIT_SENSITIVE_MAX=20

